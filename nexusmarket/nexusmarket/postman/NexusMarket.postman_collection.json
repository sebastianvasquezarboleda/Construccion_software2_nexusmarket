        },
        {
          "name": "Finalize order",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{orderId}}/finalize" }
        },
        {
          "name": "Get delivered shipment",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments/{{shipmentId}}" }
        },
        {
          "name": "List shipments",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments" }
        },
        {
          "name": "Request return",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('returnId', String(pm.response.json().id));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"productId\": {{productId}},\n  \"quantity\": 1,\n  \"reason\": \"Product returned in original condition\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/returns"
          }
        },
        {
          "name": "Approve return and restock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/returns/{{returnId}}/approve" }
        },
        {
          "name": "Record refund",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/returns/{{returnId}}/refund" }
        },
        {
          "name": "List returns",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/returns" }
        },
        {
          "name": "Get return",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/returns/{{returnId}}" }
        },
        {
          "name": "Administrative summary report",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/summary" }
        },
        {
          "name": "Create order for cancellation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{cancelOrderId}},\n  \"buyerId\": {{buyerId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Add product to cancellable order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders/{{cancelOrderId}}/products"
          }
        },
        {
          "name": "Cancel order and return stock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{cancelOrderId}}/cancel" }
        },
        {
          "name": "Discontinue product",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/products/{{productId}}/discontinue" }
        }
      ]
    }
  ]
}
