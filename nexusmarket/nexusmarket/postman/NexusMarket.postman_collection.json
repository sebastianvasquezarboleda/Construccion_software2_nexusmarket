{
  "info": {
    "name": "NexusMarket API",
    "description": "Pruebas de los endpoints REST de NexusMarket. Configura las credenciales de administrador antes de ejecutar; el primer request genera IDs para toda la colección. Los endpoints de listado devuelven páginas con content, page, size, totalElements y totalPages (por defecto page=0 y size=50; máximo 100).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{adminEmail}}", "type": "string" },
      { "key": "password", "value": "{{adminPassword}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "buyerId", "value": "" },
    { "key": "sellerId", "value": "" },
    { "key": "warehouseId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "inventoryId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "cancelOrderId", "value": "" },
    { "key": "sellerUserId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "shipmentId", "value": "" },
    { "key": "returnId", "value": "" },
    { "key": "expectedStatus", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const email = pm.collectionVariables.get('adminEmail');",
          "const password = pm.collectionVariables.get('adminPassword');",
          "if (!email || !password) { console.error('Set adminEmail and adminPassword before running the collection.'); pm.execution.skipRequest(); }",
          "else {",
          "  const authorization = 'Basic ' + btoa(email + ':' + password);",
          "  pm.sendRequest({ url: pm.variables.replaceIn('{{baseUrl}}') + '/api/csrf', method: 'GET', header: [{ key: 'Authorization', value: authorization }] }, (error, response) => {",
          "    if (error || response.code !== 200) { console.error('Unable to obtain CSRF token.', error || response.code); pm.execution.skipRequest(); return; }",
          "    const setCookie = response.headers.get('Set-Cookie') || '';",
          "    const cookieMatch = setCookie.match(/(?:^|,\\s*)XSRF-TOKEN=([^;]+)/);",
          "    const csrf = response.json();",
          "    if (!cookieMatch || !csrf.token || csrf.headerName !== 'X-XSRF-TOKEN') { console.error('CSRF token or cookie was not returned.'); pm.execution.skipRequest(); return; }",
          "    pm.request.headers.upsert({ key: 'Cookie', value: 'XSRF-TOKEN=' + cookieMatch[1] });",
          "    pm.request.headers.upsert({ key: csrf.headerName, value: csrf.token });",
          "  });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedStatus = pm.collectionVariables.get('expectedStatus');",
          "const acceptedStatuses = expectedStatus ? [Number(expectedStatus)] : [200, 201];",
          "pm.test('API response has expected status', () => pm.expect(pm.response.code).to.be.oneOf(acceptedStatuses));",
          "pm.collectionVariables.unset('expectedStatus');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = Date.now();",
                  "['userId','buyerId','sellerId','warehouseId','productId','inventoryId','orderId','cancelOrderId','sellerUserId'].forEach((key, index) => pm.collectionVariables.set(key, String(base + index)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created successfully', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('userId', String(pm.response.json().id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{userId}},\n  \"fullName\": \"Ana Garcia\",\n  \"email\": \"ana.{{userId}}@example.com\",\n  \"documentNumber\": \"DOC-{{userId}}\",\n  \"role\": \"BUYER\",\n  \"status\": \"ACTIVE\",\n  \"password\": \"BuyerDemoPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users" }
        },
        {
          "name": "Get user",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "Activate user",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/users/{{userId}}/activate" }
        },
        {
          "name": "Block user",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/users/{{userId}}/block" }
        },
        {
          "name": "Create seller user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{sellerUserId}},\n  \"fullName\": \"Carlos Vendedor\",\n  \"email\": \"seller.{{sellerUserId}}@example.com\",\n  \"documentNumber\": \"SELLER-{{sellerUserId}}\",\n  \"role\": \"SELLER\",\n  \"status\": \"ACTIVE\",\n  \"password\": \"SellerDemoPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Buyer cannot read another user's account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('expectedStatus', '403');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "ana.{{userId}}@example.com", "type": "string" },
                { "key": "password", "value": "BuyerDemoPass123!", "type": "string" }
              ]
            },
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{sellerUserId}}"
          }
        }
      ]
    },
    {
      "name": "Buyers",
      "item": [
        {
          "name": "Create buyer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{buyerId}},\n  \"userId\": {{userId}},\n  \"mainAddress\": \"Calle 10 # 20-30\",\n  \"additionalAddresses\": [\"Avenida 80 # 78-90\"],\n  \"commercialStatus\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/buyers"
          }
        },
        {
          "name": "List buyers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/buyers" }
        },
        {
          "name": "Get buyer",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/buyers/{{buyerId}}" }
        },
        {
          "name": "Add address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"Nueva direccion 123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/buyers/{{buyerId}}/addresses"
          }
        },
        {
          "name": "Remove address",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/buyers/{{buyerId}}/addresses?address=Nueva%20direccion%20123"
          }
        }
      ]
    },
    {
      "name": "Sellers",
      "item": [
        {
          "name": "Create seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{sellerId}},\n  \"userId\": {{sellerUserId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/sellers"
          }
        },
        {
          "name": "List sellers",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sellers" }
        },
        {
          "name": "Get seller",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/sellers/{{sellerId}}" }
        }
      ]
    },
    {
      "name": "Warehouses",
      "item": [
        {
          "name": "Create warehouse",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{warehouseId}},\n  \"name\": \"Bodega principal\",\n  \"type\": \"MARKETPLACE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/warehouses"
          }
        },
        {
          "name": "List warehouses",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/warehouses" }
        },
        {
          "name": "Get warehouse",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/warehouses/{{warehouseId}}" }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{productId}},\n  \"sellerId\": {{sellerId}},\n  \"name\": \"Teclado mecanico\",\n  \"description\": \"Teclado para gaming\",\n  \"type\": \"PHYSICAL\",\n  \"variants\": [\"US\", \"EU\"],\n  \"status\": \"SUSPENDED\",\n  \"price\": 125.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products"
          }
        },
        {
          "name": "List products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Get product",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "Publish product",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/products/{{productId}}/publish" }
        },
        {
          "name": "Update product price",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 125.50\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/price"
          }
        },
        {
          "name": "Suspend product",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/products/{{productId}}/suspend" }
        },
        {
          "name": "Add product variant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variant\": \"LATAM\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}/variants"
          }
        },
        {
          "name": "Republish product",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/products/{{productId}}/publish" }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create inventory",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{inventoryId}},\n  \"productId\": {{productId}},\n  \"warehouseId\": {{warehouseId}},\n  \"quantity\": 20\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/inventories"
          }
        },
        {
          "name": "List inventory",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/inventories" }
        },
        {
          "name": "Get inventory (including movement history)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}" }
        },
        {
          "name": "Add stock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}/add?amount=5" }
        },
        {
          "name": "Reserve stock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}/reserve?amount=2" }
        },
        {
          "name": "Remove stock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}/remove?amount=1" }
        },
        {
          "name": "Return stock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}/return?amount=1" }
        },
        {
          "name": "Adjust stock",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}/adjust?quantity=25" }
        },
        {
          "name": "Mark stock as damaged",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/inventories/{{inventoryId}}/damage?amount=1" }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{orderId}},\n  \"buyerId\": {{buyerId}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "List orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders" }
        },
        {
          "name": "Get order",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}" }
        },
        {
          "name": "Add product to order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/products"
          }
        },
        {
          "name": "Remove product from order",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/orders/{{orderId}}/products/{{productId}}" }
        },
        {
          "name": "Add product again",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/orders/{{orderId}}/products"
          }
        },
        {
          "name": "Send order to payment",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{orderId}}/payment" }
        },
        {
          "name": "Mark order as paid",
          "request": { "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{orderId}}/paid" }
        },
        {
          "name": "Get order invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('invoiceId', String(pm.response.json().id));"]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}/invoice" }
        },
        {
          "name": "List invoices",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/invoices" }
        },
        {
          "name": "Get invoice",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/invoices/{{invoiceId}}" }
        },
        {
          "name": "Create shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('shipmentId', String(pm.response.json().id));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{orderId}},\n  \"deliveryAddress\": \"Calle 10 # 20-30\"\n}",
